# Copy to .env.local for local development. Never commit real values.
# Local Supabase values are printed by `npm run db:start`.

# Public: safe for the browser (anon key is protected by RLS, not secrecy).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS. Used solely by narrowly scoped server code
# after explicit permission checks. Never import into client components.
SUPABASE_SERVICE_ROLE_KEY=

# Application origin used for auth redirects and emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Later phases (declared now so deployments reserve them; unused in Phase 1).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHIPSTATION_API_KEY=
EMAIL_PROVIDER_API_KEY=
CHROBINSON_CLIENT_ID=
CHROBINSON_CLIENT_SECRET=
